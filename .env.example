VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
QUEST_TEST_EMAIL=
QUEST_TEST_PASSWORD=
# Same address as QUEST_TEST_EMAIL. Baked into the browser bundle at build time (also set it on Vercel):
# the only non-admin Payments login the staff-only gate admits, so e2e and verify:live keep working.
QUEST_ALLOWED_TEST_EMAIL=
# Server-only. Read by api/weekly-council.ts from process.env. Never prefix VITE_.
# Never import this in src/. Never put it in a response or a log line.
ANTHROPIC_API_KEY=
# Nightly export (Vercel cron → /api/nightly-export). Same Payments login the SPA uses.
# Store is Quest-owned (Vercel Blob or QUEST_EXPORT_STORE_DIR) — never a Payments table.
QUEST_VIEWER_EMAIL=
QUEST_VIEWER_PASSWORD=
BLOB_READ_WRITE_TOKEN=
QUEST_EXPORT_STORE_DIR=
CRON_SECRET=
QUEST_PUBLIC_URL=https://quest.terrafunded.com
# Email alerts when a nightly run differs from the previous one. No send if unset.
RESEND_API_KEY=
QUEST_ALERT_EMAIL=
QUEST_ALERT_FROM=
